# Copy to .env and fill in (cp .env.example .env). .env is git-ignored.
# No quotes around values: the Makefile reads this file with `include`.
OPENAI_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Verbosity of the importer logs: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
