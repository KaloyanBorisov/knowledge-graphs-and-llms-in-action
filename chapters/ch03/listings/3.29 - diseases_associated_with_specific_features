MATCH (phe:HpoPhenotype)
WHERE phe.label IN ["Growth delay", "Large knee", "Sensorineural hearing impairment", "Pruritus", "Type I diabetes mellitus"]
WITH phe
MATCH (dis:HpoDisease)-[r:HAS_PHENOTYPIC_FEATURE]->(phe)
RETURN dis.id AS disease_id,
dis.label AS disease_name,
collect(DISTINCT r.evidenceName) AS evidence_name,
collect(DISTINCT r.evidenceDescription) AS evidence_description,
collect(DISTINCT r.source) AS source,
collect(DISTINCT r.url) AS url,
collect(DISTINCT phe.label) AS features,
count(DISTINCT phe) AS num_of_features
ORDER BY num_of_features DESC, disease_name
LIMIT 5
